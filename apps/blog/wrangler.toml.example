# Copiar como wrangler.toml en la configuración local de Cloudflare.
# No contiene IDs ni secretos. `wrangler secret put INGEST_SECRET` es obligatorio.
name = "blog-ia"
main = "src/worker.ts"
compatibility_date = "2026-10-20"

[vars]
API_HOST = "api.blog.example.com"
INGEST_RATE_LIMIT = "60"

[[d1_databases]]
binding = "DB"
database_name = "blog-ia"
database_id = "REEMPLAZAR_CON_ID_D1"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "blog-ia-media"
